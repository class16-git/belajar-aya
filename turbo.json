{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "ATLAS_CONTENT_MIN_REVIEW",
    "ATLAS_ENV",
    "ATLAS_SECURE_COOKIES",
    "TEST_DATABASE_URL",
    "E2E_DATABASE_URL",
    "VERCEL",
    "VERCEL_ENV",
    "ATLAS_PUBLIC_ORIGIN",
    "ATLAS_SIGNUP_ALLOWED_EMAILS"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "@atlas/database#generate"
      ]
    },
    "@atlas/database#generate": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "@atlas/database#generate"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
