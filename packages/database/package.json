{
  "name": "@atlas/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "seed:private": "tsx src/seed-private.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "db-role": "tsx src/db-role.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@atlas/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
