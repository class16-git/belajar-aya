{
  "name": "@atlas/curriculum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "approve": "tsx scripts/approve.ts",
    "index": "node scripts/index-content.mjs",
    "religious-approve": "tsx scripts/religious-approve.ts",
    "coverage": "tsx scripts/coverage.ts",
    "library-approve": "tsx scripts/library-approve.ts",
    "library-withdraw": "LIBRARY_ACTION=withdraw tsx scripts/library-approve.ts",
    "release-manifest": "tsx scripts/release-manifest.ts"
  },
  "dependencies": {
    "@atlas/shared": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
