# Copy to .env (git-ignored). Never commit real secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atlas_dev"
# Deployment environment: production | preview | development. A production build defaults to "production".
# "preview" is ONLY for environments with fake/synthetic children (CI, E2E, review apps).
ATLAS_ENV="development"
# Lowest content review status shown to children. Production default and minimum: "reviewed" (human-reviewed).
# Development/preview may use "agent_reviewed" so the vertical slice is usable before owner review.
ATLAS_CONTENT_MIN_REVIEW="agent_reviewed"
# Production: the exact public origin(s) allowed to send mutations (comma-separated), e.g. "https://atlas.example.org".
# When unset, the Origin header must match the Host header.
ATLAS_PUBLIC_ORIGIN=""
# Who may create a parent account (comma-separated). Production with this empty = sign-up closed to everyone.
# Set the real value only in the host's secret settings, never in this file.
ATLAS_SIGNUP_ALLOWED_EMAILS=""
# Secure cookies (set to "true" behind HTTPS).
ATLAS_SECURE_COOKIES="false"
# Optional runtime AI: disabled. No provider is wired in Phase 1.
ATLAS_AI_PROVIDER="none"
